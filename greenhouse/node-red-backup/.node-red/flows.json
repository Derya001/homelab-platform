    {
        "id": "befcbcd8798a5121",
        "type": "function",
        "z": "e49c745f1c9697f1",
        "name": "Lámpa trigger logika",
        "func": "const THRESH = 2;\nconst START_NIGHT = 19;\nconst END_NIGHT = 8;\nconst h = new Date().getHours();\nconst night = (h >= START_NIGHT || h < END_NIGHT);\n\nconst lux = Number(msg.payload);\nif (isNaN(lux)) return null;\n\nlet prevLow = flow.get('lux_prev_low') || false;\nlet running = flow.get('lamp_running') || false;\nlet nowLow = lux < THRESH;\nflow.set('lux_prev_low', nowLow);\n\nif (!night && nowLow && !prevLow && !running) {\n    flow.set('lamp_running', true);\n    return { payload: 'start' };\n}\nif (night && nowLow) {\n    return { payload: 'Éjszakai mód – nem kapcsol.' };\n}\nreturn null;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 100,
        "wires": [
            [
                "1d14b7f2c1d9b697"
            ]
        ]
    },
