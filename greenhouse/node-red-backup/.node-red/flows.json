    {
        "id": "3c63cf1b515e96b3",
        "type": "function",
        "z": "e49c745f1c9697f1",
        "name": "Talaj állapot szöveg",
        "func": "const pct = (typeof msg.soil_pct === 'number') ? msg.soil_pct : Number(msg.payload);\nif (isNaN(pct)) return null;\nlet text;\nif (pct >= 70) text = `NEDVES (${pct}%)`;\nelse if (pct >= 40) text = `OK (${pct}%)`;\nelse if (pct >= 25) text = `ALACSONY (${pct}%)`;\nelse text = `SZÁRAZ (${pct}%)`;\nmsg.payload = text;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 700,
        "y": 280,
        "wires": [
            []
        ]
    },
    {
        "id": "7530501325e5b942",
        "type": "function",
        "z": "e49c745f1c9697f1",
        "name": "Szivattyú trigger logika",
        "func": "const THRESH = 35;\n\nlet pct = (typeof msg.soil_pct === 'number') ? msg.soil_pct : Number(msg.payload);\nif (isNaN(pct)) return null;\n\nlet prevLow = flow.get('soil_prev_low') || false;\nlet running = flow.get('pump_running') || false;\n\nlet nowLow = pct < THRESH;\nflow.set('soil_prev_low', nowLow);\n\nif (nowLow && !prevLow && !running) {\n    flow.set('pump_running', true);\n    return { payload: 'pump_start' };\n}\n\nreturn null;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 700,
        "y": 340,
        "wires": [
