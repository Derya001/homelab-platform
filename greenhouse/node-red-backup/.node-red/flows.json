    {
        "id": "6e2d06c5b5d29dd0",
        "type": "function",
        "z": "e49c745f1c9697f1",
        "name": "Talaj % számítás (kalibráció)",
        "func": "const DRY = 26000;\nconst WET = 7000;\nlet raw = Number(msg.payload);\nif (isNaN(raw)) return null;\nif (raw < WET) raw = WET;\nif (raw > DRY) raw = DRY;\nlet pct = (DRY - raw) / (DRY - WET) * 100;\npct = Math.round(Math.max(0, Math.min(100, pct)));\nconst toGauge = { payload: pct };\nconst toState = { soil_pct: pct };\nreturn [toGauge, toState];",
        "outputs": 2,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 260,
        "wires": [
            [
                "231ef84cfe917d72"
            ],
            [
                "3c63cf1b515e96b3",
                "7530501325e5b942"
            ]
        ]
    },
