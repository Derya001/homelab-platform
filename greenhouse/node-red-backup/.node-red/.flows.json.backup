    {
        "id": "12c706e769599ff3",
        "type": "function",
        "z": "tab_uveghaz",
        "name": "Fény figyelmeztetés",
        "func": "let lux = Number(msg.payload);\nif (isNaN(lux)) return null;\nif (lux < 6) {\n    msg.payload = \"Lámpát bekapcsolni 💡\";\n} else {\n    msg.payload = \"\";\n}\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 390,
        "y": 120,
        "wires": [
            [
                "2a8033427ddebdc0"
            ]
        ]
    },
    {
        "id": "2a8033427ddebdc0",
        "type": "ui_text",
        "z": "tab_uveghaz",
        "group": "ui_group_uveghaz",
        "order": 10,
        "width": 12,
        "height": 1,
        "name": "Fény figyelmeztetés",
        "label": "",
        "format": "{{msg.payload}}",
        "layout": "row-spread",
        "x": 670,
        "y": 120,
        "wires": []
    },
    {
        "id": "d30fc187a74570e2",
        "type": "mqtt in",
        "z": "tab_uveghaz",
        "name": "Talajnedvesség (ADC)",
        "topic": "sensors/soil",
        "qos": "0",
        "datatype": "auto",
        "broker": "31161ab67c2cdb4c",
        "inputs": 0,
        "x": 150,
        "y": 160,
        "wires": [
            [
                "258101bb552cc560"
            ]
        ]
    },
    {
        "id": "258101bb552cc560",
        "type": "function",
        "z": "tab_uveghaz",
        "name": "Talaj % számítás (kalibráció)",
        "func": "const DRY = 26000;\nconst WET = 7000;\nlet raw = Number(msg.payload);\nif (isNaN(raw)) return null;\nif (raw < WET) raw = WET;\nif (raw > DRY) raw = DRY;\nlet pct = (DRY - raw) / (DRY - WET) * 100;\npct = Math.round(Math.max(0, Math.min(100, pct)));\nconst toGauge = { payload: pct };\nconst toState = { soil_pct: pct };\nreturn [toGauge, toState];",
        "outputs": 2,
        "noerr": 0,
        "x": 410,
        "y": 160,
        "wires": [
            [
                "0055d17966035d43"
            ],
            [
                "9d737dc750a54dea"
            ]
        ]
    },
    {
        "id": "9d737dc750a54dea",
        "type": "function",
        "z": "tab_uveghaz",
        "name": "Talaj állapot szöveg",
        "func": "const pct = (typeof msg.soil_pct === 'number') ? msg.soil_pct : Number(msg.payload);\nif (isNaN(pct)) return null;\nlet text;\nif (pct >= 70) text = `NEDVES 💧 (${pct}%)`;\nelse if (pct >= 40) text = `OK ✅ (${pct}%)`;\nelse if (pct >= 25) text = `ALACSONY ⚠️ (${pct}%)`;\nelse text = `SZÁRAZ ☠️ (${pct}%)`;\nmsg.payload = text;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 420,
        "y": 220,
        "wires": [
            [
                "12bb595948f3ddd2",
                "2ec5f2720d813ea8"
            ]
        ]
    },
    {
        "id": "0055d17966035d43",
        "type": "ui_gauge",
        "z": "tab_uveghaz",
        "name": "Talajnedvesség",
        "group": "ui_group_uveghaz",
        "order": 1,
        "width": 6,
        "height": 3,
        "gtype": "gage",
        "title": "Talajnedvesség (%)",
        "label": "%",
        "format": "{{value}}",
        "min": 0,
        "max": 100,
        "colors": [
            "#ff0000",
            "#00ff00",
            "#0000ff"
        ],
