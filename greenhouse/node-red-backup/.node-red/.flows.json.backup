    {
        "id": "3067deb140a3bb70",
        "type": "ui_gauge",
        "z": "tab_uveghaz",
        "name": "Fényerő",
        "group": "ui_group_uveghaz",
        "order": 2,
        "width": 6,
        "height": 3,
        "gtype": "gage",
        "title": "Fényerő (lux)",
        "label": "lux",
        "format": "{{value}}",
        "min": 0,
        "max": 500,
        "colors": [
            "#fdfd96",
            "#00ff00",
            "#0000ff"
